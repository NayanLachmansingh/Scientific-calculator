import math
import os
import ast
import operator
def calculate(node):
    if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
        return node.value

    if isinstance(node, ast.BinOp):
        left = calculate(node.left)
        right = calculate(node.right)

        if isinstance(node.op, ast.Add):
            return left + right
        if isinstance(node.op, ast.Sub):
            return left - right
        if isinstance(node.op, ast.Mult):
            return left * right
        if isinstance(node.op, ast.Div):
            if right == 0:
                raise ValueError("Division by zero is not allowed.")
            return left / right
        if isinstance(node.op, ast.Pow):
            return left ** right

    if isinstance(node, ast.UnaryOp):
        value = calculate(node.operand)

        if isinstance(node.op, ast.UAdd):
            return +value
        if isinstance(node.op, ast.USub):
            return -value

    if isinstance(node, ast.Call) and isinstance(node.func, ast.Name):
        name = node.func.id
        if node.keywords:
            raise ValueError("That function is not available.")

        supported_functions = {
            "addition": addition,
            "subtraction": subtraction,
            "multiplication": multiplication,
            "division": division,
            "exponentiation": exponentiation,
            "logarithm": logarithm,
            "square_root": square_root,
            "quadratic_solver": quadratic_solver,
            "sine": sine,
            "cosine": cosine,
            "tangent": tangent,
        }

        if name not in supported_functions:
            raise ValueError("That function is not available.")

        args = [calculate(arg) for arg in node.args]
        return supported_functions[name](*args)

    raise ValueError("Please enter a valid calculation.")


def main():
    print("Welcome to the Scientific Calculator!")
    print("Use +, -, *, /, ^ and functions like sine(30) or square_root(9).")
    print("Type 'quit' to exit.")

    while True:
        choice = input("Enter a calculation: ").strip()

        if choice.lower() == "quit":
            break

        try:
            # Convert ^ to Python's exponent operator.
            expression = choice.replace("^", "**")
            tree = ast.parse(expression, mode="eval")
            result = calculate(tree.body)
            print(f"Result: {result}")
        except (SyntaxError, ValueError, TypeError, ZeroDivisionError) as error:
            print(f"Could not calculate that: {error}")
        

         
    
def addition(a, b):
    return a + b
def subtraction(a, b):
    return a - b
def multiplication(a, b):
    return a * b
def division(a, b):
    if b != 0:
        return a / b
    else:
        raise ValueError("Division by zero is not allowed.")
def exponentiation(a, b):
    return a ** b
def logarithm(a, b):
    if a > 0 and b > 0:
        return math.log(a, b)
    else:
        raise ValueError("Logarithm is only defined for positive numbers.")
def square_root(a):
    if a >= 0:
        return math.sqrt(a)
    else:
        raise ValueError("Square root is only defined for non-negative numbers.")
def quadratic_solver(a, b, c):
    discriminant = b**2 - 4*a*c
    if discriminant > 0:
        root1 = (-b + math.sqrt(discriminant)) / (2*a)
        root2 = (-b - math.sqrt(discriminant)) / (2*a)
        return root1, root2
    elif discriminant == 0:
        root = -b / (2*a)
        return root,
    else:
        return None
def sine(angle):
    radians = math.radians(angle)
    return math.sin(radians)
def cosine(angle):
    radians = math.radians(angle)
    return math.cos(radians)
def tangent(angle):
    radians = math.radians(angle)
    return math.tan(radians)


        





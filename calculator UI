import tkinter as tk

root = tk.Tk()
root.title("Calculator")
root.geometry("460x800")
root.resizable(False, False)
root.configure(bg="#eef1f5")

panel = tk.Frame(root, bg="#202938", padx=20, pady=20)
panel.pack(padx=25, pady=20, fill="both", expand=True)

display = tk.Frame(panel, bg="#f8fafc", height=108)
display.grid(row=0, column=0, columnspan=4, sticky="ew", pady=(0, 18))
display.pack_propagate(False)

title = tk.Label(display, text="CALCULATOR", bg="#f8fafc", fg="#64748b",
                 font=("Arial", 16), anchor="w")
title.pack(fill="x", padx=20, pady=(14, 0))

result = tk.Label(display, text="0", bg="#f8fafc", fg="#172033",
                  font=("Arial", 24), anchor="w")
result.pack(fill="x", padx=20, pady=8)

basic_buttons = [
    ["C", "±", "%", "÷"],
    ["7", "8", "9", "×"],
    ["4", "5", "6", "−"],
    ["1", "2", "3", "+"],
    ["DEL", "0", ".", "="],
]

scientific_buttons = [
    ["sin", "cos", "tan", "log"],
    ["ln", "√", "x²", "xʸ"],
    ["π", "(", ")", "!"],
]

operator_color = "#5268e8"
basic_color = "#344154"
scientific_color = "#46546b"
hover_color = "#7588ff"


def highlight_button(event):
    event.widget.configure(bg=hover_color)


def restore_button_color(event):
    button = event.widget
    button.configure(bg=button.original_color, fg=button.original_text_color)


for column in range(4):
    panel.grid_columnconfigure(column, weight=1)

for row in range(len(basic_buttons)):
    for column in range(4):
        label = basic_buttons[row][column]
        color = basic_color

        if label == "=":
            color = "#18a879"
        elif label in ["÷", "×", "−", "+"]:
            color = operator_color

        button = tk.Button(
            panel,
            text=label,
            bg=color,
            fg="white",
            activebackground=hover_color,
            activeforeground="white",
            font=("Arial", 18),
            relief="flat",
            borderwidth=0,
        )
        button.grid(row=row + 1, column=column, padx=4, pady=3,
                    sticky="nsew", ipady=8)
        button.original_color = color
        button.original_text_color = "white"
        button.bind("<Enter>", highlight_button)
        button.bind("<Leave>", restore_button_color)

scientific_frame = tk.Frame(panel, bg="#202938")
for column in range(4):
    scientific_frame.grid_columnconfigure(column, weight=1)

for row in range(len(scientific_buttons)):
    for column in range(4):
        label = scientific_buttons[row][column]

        button = tk.Button(
            scientific_frame,
            text=label,
            bg=scientific_color,
            fg="white",
            activebackground=hover_color,
            activeforeground="white",
            font=("Arial", 14),
            relief="flat",
            borderwidth=0,
        )
        button.grid(row=row, column=column, padx=4, pady=3,
                    sticky="nsew", ipady=8)
        button.original_color = scientific_color
        button.original_text_color = "white"
        button.bind("<Enter>", highlight_button)
        button.bind("<Leave>", restore_button_color)


def toggle_scientific():
    if scientific_frame.winfo_manager():
        scientific_frame.grid_remove()
        scientific_menu.configure(text="Scientific functions  ▾")
    else:
        scientific_frame.grid(row=7, column=0, columnspan=4, sticky="ew")
        scientific_menu.configure(text="Scientific functions  ▴")


scientific_menu = tk.Button(
    panel,
    text="Scientific functions  ▾",
    command=toggle_scientific,
    bg="#344154",
    fg="#e2e8f0",
    activebackground=hover_color,
    activeforeground="white",
    font=("Arial", 14),
    anchor="w",
    padx=16,
    relief="flat",
    borderwidth=0,
)
scientific_menu.grid(row=6, column=0, columnspan=4,
                     sticky="ew", pady=(10, 4), ipady=7)
scientific_menu.original_color = "#344154"
scientific_menu.original_text_color = "#e2e8f0"
scientific_menu.bind("<Enter>", highlight_button)
scientific_menu.bind("<Leave>", restore_button_color)

root.mainloop()

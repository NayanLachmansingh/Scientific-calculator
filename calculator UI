import tkinter as tk

root = tk.Tk()
root.title("Calculator")
root.geometry("420x780")
root.resizable(False, False)
root.configure(bg="#eef1f5")

panel = tk.Frame(root, bg="#202938", padx=20, pady=25)
panel.pack(padx=30, pady=25, fill="both", expand=True)

display = tk.Frame(panel, bg="#f8fafc", height=108)
display.grid(row=0, column=0, columnspan=4, sticky="ew", pady=(0, 60))
display.pack_propagate(False)

tk.Label(display, text="CALCULATOR", bg="#f8fafc", fg="#64748b",
         font=("Arial", 16), anchor="w").pack(fill="x", padx=20, pady=(14, 0))
tk.Label(display, text="0", bg="#f8fafc", fg="#172033",
         font=("Arial", 24), anchor="w").pack(fill="x", padx=20, pady=8)

basic_buttons = [
    ["C", "±", "%", "÷"],
    ["7", "8", "9", "×"],
    ["4", "5", "6", "−"],
    ["1", "2", "3", "+"],
    ["DEL", "0", ".", "="],
]

scientific_buttons = [
    ["sin", "cos", "tan", "log"],
    ["ln", "√", "x²", "xʸ"],
    ["π", "(", ")", "!"],
]

operator_color = "#5268e8"
basic_color = "#344154"
scientific_color = "#46546b"
hover_color = "#7588ff"


def add_buttons(rows, start_row, color, font_size):
    for row, labels in enumerate(rows):
        for column, label in enumerate(labels):
            button_color = "#18a879" if label == "=" else color
            if label in ["÷", "×", "−", "+"]:
                button_color = operator_color

            button = tk.Button(
                panel,
                text=label,
                bg=button_color,
                fg="white",
                activebackground=hover_color,
                activeforeground="white",
                font=("Arial", font_size),
                relief="flat",
                borderwidth=0,
            )
            button.grid(row=start_row + row, column=column,
                        padx=4, pady=3, sticky="nsew", ipady=8)
            button.bind(
                "<Enter>",
                lambda event, item=button: item.configure(bg=hover_color),
            )
            button.bind(
                "<Leave>",
                lambda event, item=button, base=button_color:
                    item.configure(bg=base),
            )

for column in range(4):
    panel.grid_columnconfigure(column, weight=1)

tk.Label(panel, text="SCIENTIFIC FUNCTIONS", bg="#344154", fg="#e2e8f0",
         font=("Arial", 14), anchor="w", padx=16, pady=10).grid(
             row=6, column=0, columnspan=4, sticky="ew", pady=(10, 4)
         )

add_buttons(basic_buttons, 1, basic_color, 18)
add_buttons(scientific_buttons, 7, scientific_color, 14)

root.mainloop()
